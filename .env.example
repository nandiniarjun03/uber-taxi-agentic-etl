# Copy to .env for local runs. On Databricks, secrets come from the secret scope instead.
# NEVER commit real values.

# ---- Storage ----------------------------------------------------------------
STORAGE_MODE=local                      # local | adls
STORAGE_ACCOUNT_NAME=                   # e.g. uberetladls01 (ADLS Gen2, hierarchical namespace on)
LOCAL_LAKEHOUSE_ROOT=./lakehouse
DATASET_NAME=uber_rides
TABLE_FORMAT=delta                      # delta | parquet
OPTIMIZE_GOLD=false                     # true on Databricks: OPTIMIZE + ZORDER Gold tables

# Service principal for ADLS (local runs only - on Databricks use the secret scope)
DATABRICKS_SECRET_SCOPE=uber-etl
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# ---- Execution backend ------------------------------------------------------
EXECUTION_BACKEND=local                 # local | databricks
DATABRICKS_HOST=                        # https://adb-<id>.<n>.azuredatabricks.net
DATABRICKS_TOKEN=                       # or use Azure CLI / service principal auth
DATABRICKS_BRONZE_SILVER_JOB_ID=        # job id printed by `databricks bundle deploy`
DATABRICKS_FULL_JOB_ID=

# ---- Microsoft Foundry (Azure OpenAI) ---------------------------------------
LLM_MODE=auto                           # auto | foundry | offline
AZURE_OPENAI_ENDPOINT=                  # https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # your deployment name
AZURE_OPENAI_API_VERSION=2024-10-21
FOUNDRY_AUTH=entra                      # entra (DefaultAzureCredential) | key
AZURE_OPENAI_API_KEY=                   # only when FOUNDRY_AUTH=key

# ---- Agent guardrails -------------------------------------------------------
LLM_MAX_TOKENS_PER_CALL=800
LLM_MAX_TOKENS_PER_RUN=12000
LLM_MAX_RETRIES=2
JOB_MAX_RETRIES=1
JOB_POLL_SECONDS=15
JOB_TIMEOUT_SECONDS=3600
BACKFILL_LIMIT_DAYS=31
AGENT_AUTO_APPROVE=false
MANUAL_VALIDATION_MINUTES=45

# ---- Quality thresholds (optional overrides) --------------------------------
DQ_QUARANTINE_WARN=0.02
DQ_QUARANTINE_FAIL=0.05
DQ_VOLUME_WARN=0.10
DQ_VOLUME_FAIL=0.20
DQ_PAYMENT_MISSING_WARN=0.001
DQ_PAYMENT_MISSING_FAIL=0.05
